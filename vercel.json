{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/check-users",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "app/api/queues/slack-status/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "slack-status",
          "retryAfterSeconds": 60
        }
      ]
    }
  }
}
