{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:deploy-migrate && pnpm build",
  "crons": [
    {
      "path": "/api/check-users",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/echoes",
      "schedule": "0 20 * * 1-5"
    }
  ],
  "functions": {
    "app/api/queues/slack-status/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "slack-status",
          "retryAfterSeconds": 60
        }
      ]
    }
  }
}
