# ---- Local development (Local Sandbox; Slack is not contacted) ----
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=
# The sandbox workspace. Keep these literal values locally; the intake rejects other ids.
SLACK_TEAM_ID=T_LOCAL
SLACK_CHANNEL_ID=C_LOCAL
# Vercel AI Gateway key for attendance extraction. Without it only shorthand ("wfh") works.
AI_GATEWAY_API_KEY=
# AI Gateway model ID (provider/model format).
SLACK_EXTRACTION_MODEL=openai/gpt-6-luna
# Agreeing AI readings of a whole message before it becomes a learned shorthand. Leave empty
# to turn learning off.
SLACK_SHORTHAND_LEARNING_THRESHOLD=3
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=work_dev
# Optional existing realtime transport; polling still updates the dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push (optional). Generate keys with `npx web-push generate-vapid-keys`. Without them
# notifications stay off and the Profile page says so.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Preview and production only (Vercel), never in .env.local ----
# Real workspace: SLACK_TEAM_ID=T02HKL21R, SLACK_CHANNEL_ID=C94UDEF8X
# AUTH_SLACK_ID=
# AUTH_SLACK_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# CRON_SECRET=
# DATABASE_URL=
